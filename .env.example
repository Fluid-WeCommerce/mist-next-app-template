# Mist droplet — example environment. Copy to .env.local and fill in.
# In production these are set on the Vercel project by Mist; you only need
# them locally to exercise the Fluid handshake and webhooks.

# --- Database ---
# Not needed for `npm run dev` (that uses PGlite → ./local.db).
# Set only when running against a real Postgres/Neon.
# DATABASE_URL=postgresql://user:pass@host/db

# --- Fluid platform ---
FLUID_BASE_URL=https://fluid.app
FLUID_API_URL=https://api.fluid.app

# The droplet's identity, issued by Fluid when you register the droplet.
FLUID_DROPLET_UUID=drp_your-droplet-uuid

# HMAC secret used to verify the JWT from the /droplet/connect handshake.
# Existing Mist deployments also use this as the webhook auth fallback.
FLUID_DROPLET_SECRET=your-droplet-secret

# Shared secret used to authenticate lifecycle webhooks
# (droplet.installed / droplet.uninstalled) and as the fallback for
# company webhooks that predate per-company verification tokens.
# New Mist deployments set this explicitly; if omitted, the app falls back
# to FLUID_DROPLET_SECRET for backwards compatibility.
FLUID_WEBHOOK_AUTH_TOKEN=your-webhook-auth-token

# This droplet's own public URL, used to build the callback/webhook URLs
# registered with Fluid. On Vercel this is derived from the stable
# VERCEL_PROJECT_PRODUCTION_URL if unset.
# APP_URL=https://your-droplet.vercel.app

# --- register:webhooks script only ---
# Bearer token for YOUR company, used to update the Droplet's lifecycle
# install/uninstall webhook URLs.
# FLUID_TOKEN=your-company-bearer-token
